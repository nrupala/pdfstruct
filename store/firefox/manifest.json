{
 "action": {
  "default_popup": "popup.html",
  "default_title": "PDFStruct",
  "default_icon": {
   "16": "icons/icon16.png",
   "32": "icons/icon32.png",
   "48": "icons/icon48.png",
   "128": "icons/icon128.png"
  }
 },
 "description": "Decompose a PDF into its outline tree with page ranges and section text — entirely in your browser.",
 "content_security_policy": {
  "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
 },
 "host_permissions": [
  "https://aimlds.org/*"
 ],
 "manifest_version": 3,
 "name": "PDFStruct",
 "version": "0.2.1",
 "icons": {
  "16": "icons/icon16.png",
  "32": "icons/icon32.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
 },
 "browser_specific_settings": {
  "gecko": {
   "id": "pdfstruct@aimlds.org",
   "strict_min_version": "109.0"
  }
 }
}