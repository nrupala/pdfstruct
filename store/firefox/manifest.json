{
 "action": {
  "default_popup": "popup.html",
  "default_title": "PDFStruct"
 },
 "description": "See a PDF's outline tree via your local PDFStruct API. Fully local; needs pdfstruct-api running.",
 "host_permissions": [
  "http://127.0.0.1:8766/*",
  "http://localhost:8766/*"
 ],
 "manifest_version": 3,
 "name": "PDFStruct",
 "version": "0.1.0",
 "browser_specific_settings": {
  "gecko": {
   "id": "pdfstruct@aimlds.org",
   "strict_min_version": "109.0"
  }
 }
}